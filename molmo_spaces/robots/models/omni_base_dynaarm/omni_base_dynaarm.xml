  <contact>
    <exclude body1="base" body2="left_driver"/>
    <exclude body1="base" body2="right_driver"/>
    <exclude body1="base" body2="left_spring_link"/>
    <exclude body1="base" body2="right_spring_link"/>
    <exclude body1="right_coupler" body2="right_follower"/>
    <exclude body1="left_coupler" body2="left_follower"/>
    <!-- The DynaArm upperarm collision mesh nests 20 mm INSIDE the arm-base
         mesh (merged into base_link) at the folded rest pose — real parts
         interleave across the shoulder joint. base_link is the upperarm's
         GRANDparent (base_link > shoulder > upperarm), so MuJoCo does not
         auto-exclude the pair, and the phantom contact acts as a friction
         brake that stalls shoulder_flexion against its 40 Nm actuator clamp
         (measured: qfrc_constraint -36 Nm vs qfrc_actuator +40, joint
         immobile). Real base-arm collisions stay guarded by the controller's
         base/chassis capsules. -->
    <exclude body1="base_link" body2="upperarm"/>
  </contact>

  <tendon>
    <fixed name="split">
      <joint joint="right_driver_joint" coef="0.5"/>
      <joint joint="left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <actuator>
    <position class="base_slide" name="x_to_world_act" joint="x_to_world_joint" ctrlrange="-100 100"/>
    <position class="base_slide" name="y_to_x_act"     joint="y_to_x_joint"     ctrlrange="-100 100"/>
    <position class="base_yaw"   name="base_to_y_act"  joint="base_to_y_joint"  ctrlrange="-3.1416 3.1416"/>
    <general class="2f85" name="fingers_actuator" tendon="split" forcerange="-40 40" ctrlrange="0 255"
      gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>

  <!-- Parallel-jaw conversion of the Menagerie 2F-85, verbatim from
       dynaarm_2f85.xml: `spring_link = driver` for parallelogram closure,
       `coupler = 0` pin, `follower = -driver` keeps the pad's WORLD
       orientation constant. -->
  <equality>
    <joint joint1="right_driver_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001"
      solref="0.005 1"/>
    <joint joint1="right_spring_link_joint" joint2="right_driver_joint" polycoef="0 1 0 0 0"
      solimp="0.0 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left_spring_link_joint" joint2="left_driver_joint" polycoef="0 1 0 0 0"
      solimp="0.0 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_coupler_joint" polycoef="0 0 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left_coupler_joint" polycoef="0 0 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_follower_joint" joint2="right_driver_joint" polycoef="0 -1 0 0 0"
      solimp="0.0 0.99 0.001" solref="0.005 1"/>
    <joint joint1="left_follower_joint" joint2="left_driver_joint" polycoef="0 -1 0 0 0"
      solimp="0.0 0.99 0.001" solref="0.005 1"/>
  </equality>
